datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// Your placeholder testing model
model Workout {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  exercises   Exercise[]
}

model Exercise {
  id          Int       @id @default(autoincrement())
  workoutId   Int
  workout     Workout   @relation(fields: [workoutId], references: [id])
  name        String
  description String?
  sets        Int
  reps        Int
  weight      Float
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
